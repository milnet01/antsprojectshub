node_modules/
dist/
.DS_Store
*.log

# Python bytecode for tray/ants-stats-tray.py and its tests. A build artefact keyed to the
# interpreter version (cpython-313), so it rots on every Python upgrade and is rewritten by
# every tray edit — a recurring, meaningless diff.
__pycache__/

# Private stats dashboard (npm run stats). Never published — the generated page and its
# saved history contain owner-only visitor data and must stay on this machine.
.stats/

# ROADMAP.md's next-ID cache. Derived, not source: its real value is the highest APHW-NNNN
# in ROADMAP.md + CHANGELOG.md, so a fresh clone recovers it and git can't drift it.
.roadmap-counter
