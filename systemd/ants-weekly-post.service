# Weekly blog post — started by ants-weekly-post.timer; not enabled on its own.
#
# Install (as your own user, NOT root — it needs your gh login and your Claude login):
#   mkdir -p ~/.config/systemd/user
#   ln -sf "$PWD/systemd/ants-weekly-post.service" "$PWD/systemd/ants-weekly-post.timer" ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ants-weekly-post.timer
#
#   systemctl --user list-timers ants-weekly-post       # when is the next one?
#   systemctl --user start ants-weekly-post             # run it now
#   journalctl --user -u ants-weekly-post               # what did the last run do?
#   systemctl --user disable --now ants-weekly-post.timer   # undo
#
# WorkingDirectory is absolute because a systemd unit has no notion of "where you were".
# Update it if the checkout ever moves.

[Unit]
Description=Ants Projects Hub weekly blog post
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/mnt/Games/Scripts/Linux/Ants_Projects_Hub_Website
ExecStart=/mnt/Games/Scripts/Linux/Ants_Projects_Hub_Website/scripts/weekly-post.sh
# claude installs to ~/.local/bin, which a user unit's PATH does not include.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Up to 30 minutes waiting for the keyring, then two sessions capped at 60 minutes each.
TimeoutStartSec=3h
